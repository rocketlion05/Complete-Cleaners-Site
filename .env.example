# ------------------------------------------------------------------
# Complete Cleaners — environment variables
# Copy this file to .env.local for local development. On Vercel, add
# these under Project Settings → Environment Variables.
# None of these are required for the site to run — without an email
# provider key, quote submissions are logged to the server console.
# ------------------------------------------------------------------

# Email provider: "resend" (default), "postmark", or "sendgrid"
EMAIL_PROVIDER=resend

# API key for the chosen provider (set only the one you use)
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# SENDGRID_API_KEY=

# The From address for outgoing mail. Must be a sender/domain verified
# with your email provider. Example: "Complete Cleaners <hello@completecleanersnwa.com>"
# If unset, Resend's onboarding sender is used (fine for testing only).
EMAIL_FROM=

# Where quote-request notifications are delivered.
# Defaults to hello@completecleanersnwa.com (set in src/config/business.ts).
FORM_RECIPIENT_EMAIL=

# ---- Optional analytics (all disabled unless set) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Plausible domain, e.g. completecleanersnwa.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
